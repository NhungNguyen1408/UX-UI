digraph BeautyGlow {
 graph [rankdir=LR, splines=polyline, overlap=false, nodesep=0.38, ranksep=0.95, pad=0.35, bgcolor="#ffffff", fontname="DejaVu Sans", label="BeautyGlow • MySQL Database ERD (12 bảng)", labelloc="t", fontsize=23, fontcolor="#8b2d59"];
 node [shape=plain, fontname="DejaVu Sans"];
 edge [color="#b76689", arrowsize=0.75, penwidth=1.1, fontname="DejaVu Sans", fontsize=9];
 users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#fff7fb" color="#d76d98"><tr><td bgcolor="#e25387"><font color="white"><b>users</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">full_name</td></tr><tr><td align="left">email (unique)</td></tr><tr><td align="left">password_hash</td></tr></table>>];
 addresses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>addresses</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK user_id</td></tr><tr><td align="left">recipient / phone</td></tr><tr><td align="left">street / ward / city</td></tr></table>>];
 brands [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>brands</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">name / slug</td></tr></table>>];
 categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>categories</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">name / slug</td></tr></table>>];
 products [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#fff7fb" color="#d76d98"><tr><td bgcolor="#e25387"><font color="white"><b>products</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK category_id</td></tr><tr><td align="left">FK brand_id</td></tr><tr><td align="left">name / price_vnd / stock</td></tr></table>>];
 cart_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>cart_items</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK user_id / product_id</td></tr><tr><td align="left">quantity</td></tr></table>>];
 favorites [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>favorites</b></td></tr><tr><td align="left">PK,FK user_id</td></tr><tr><td align="left">PK,FK product_id</td></tr></table>>];
 coupons [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>coupons</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">code / discount_vnd</td></tr><tr><td align="left">minimum_order_vnd</td></tr></table>>];
 orders [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#fff7fb" color="#d76d98"><tr><td bgcolor="#e25387"><font color="white"><b>orders</b></font></td></tr><tr><td align="left">PK id / order_code</td></tr><tr><td align="left">FK user_id</td></tr><tr><td align="left">shipping snapshot</td></tr><tr><td align="left">subtotal / discount / shipping</td></tr><tr><td align="left">total_vnd / status</td></tr></table>>];
 order_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>order_items</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK order_id / product_id</td></tr><tr><td align="left">product_name / unit_price</td></tr><tr><td align="left">quantity</td></tr></table>>];
 payments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>payments</b></td></tr><tr><td align="left">PK id / FK order_id</td></tr><tr><td align="left">method / status / amount</td></tr></table>>];
 reviews [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#ffffff" color="#efbad2"><tr><td bgcolor="#f5c5d8"><b>reviews</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK user_id / product_id</td></tr><tr><td align="left">rating / comment</td></tr></table>>];
 users -> addresses [label="1:N"];
 users -> cart_items [label="1:N"];
 users -> favorites [label="1:N"];
 users -> orders [label="1:N"];
 users -> reviews [label="1:N"];
 categories -> products [label="1:N"];
 brands -> products [label="1:N"];
 products -> cart_items [label="1:N"];
 products -> favorites [label="1:N"];
 products -> order_items [label="1:N"];
 products -> reviews [label="1:N"];
 orders -> order_items [label="1:N"];
 orders -> payments [label="1:1"];
 coupons -> orders [style=dashed,color="#a7a0a7",label="code dùng khi checkout\n(không FK)"];
}
